---
import { Image } from 'astro:assets';
import katexCss from 'katex/dist/katex.min.css?url';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/blog/TagList.astro';
import { blog, site } from '../config';
import { localizedHref, canonicalPath } from '../i18n/links';
import { useT } from '../i18n/t';
import { resolveLocale } from '../i18n/locales';
import { formatDate, type Post } from '../utils/posts';

const t = useT(Astro.currentLocale);

interface Props {
  post: Post;
  /** Set by the math plugin (src/utils/math.ts) when the post has `$…$` or `$$…$$` */
  math?: boolean;
}
const { post, math } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, heroAlt, tags } = post.data;
const url = new URL(canonicalPath(Astro.url.pathname), Astro.site).href;
const abs = (path: string) => new URL(path, Astro.site).href;
const image = heroImage ?? site.defaultOgImage;

const jsonLd = [
  {
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: { '@type': 'Person', name: site.author },
    image: abs(image.src),
    mainEntityOfPage: url,
    inLanguage: post.data.lang,
    keywords: tags.join(', ') || undefined,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: t.home, item: abs(localizedHref('/', Astro.currentLocale)) },
      { name: t.blog, item: abs(localizedHref('/articles/', Astro.currentLocale)) },
      { name: title, item: url },
    ].map((crumb, i) => ({ '@type': 'ListItem', position: i + 1, ...crumb })),
  },
];
---

<BaseLayout title={title} description={description} image={image} type="article" jsonLd={jsonLd}>
  {math && <link slot="head" rel="stylesheet" href={katexCss} />}
  <article
    lang={post.data.lang}
    data-search-post={Astro.currentLocale === 'en' ? '' : undefined}
    data-pagefind-meta="slug[data-post-id], lang[data-content-lang], pubDate[data-pub-date], tags[data-tags]"
    data-post-id={post.id}
    data-content-lang={post.data.lang}
    data-pub-date={pubDate.toISOString()}
    data-tags={JSON.stringify(tags)}
    class="post-measure mx-auto px-4 pt-6 pb-12 sm:py-16"
  >
    <header>
      <p
        data-pagefind-ignore
        lang={resolveLocale(Astro.currentLocale)}
        class="font-sans text-sm text-muted"
      >
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate, Astro.currentLocale)}</time>
        {updatedDate && (
          <>
            {' · '}
            {t.updated}{' '}
            <time datetime={updatedDate.toISOString()}>
              {formatDate(updatedDate, Astro.currentLocale)}
            </time>
          </>
        )}
      </p>
      <h1
        data-pagefind-meta="title"
        lang={post.data.lang}
        class="mt-3 text-4xl font-light tracking-tight wrap-anywhere sm:text-5xl"
      >
        {title}
      </h1>
      <p
        data-pagefind-meta="description"
        lang={post.data.lang}
        class="mt-4 text-xl wrap-anywhere text-muted"
      >
        {description}
      </p>
    </header>
    {heroImage && (
      <Image
        lang={post.data.lang}
        src={heroImage}
        alt={heroAlt ?? ''}
        widths={[720, 1440]}
        sizes="(min-width: 720px) 720px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="mt-6 w-full rounded sm:mt-10"
      />
    )}
    <div
      data-post-content
      lang={post.data.lang}
      class:list={['prose sm:mt-12', heroImage ? 'mt-8' : 'mt-6', blog.dropCap && 'drop-cap']}
    >
      <slot />
    </div>
    <footer
      lang={resolveLocale(Astro.currentLocale)}
      class="mt-16 space-y-6 border-t border-border pt-8"
    >
      <TagList contentLang={post.data.lang} tags={tags} />
      <p data-pagefind-ignore class="font-sans text-sm">
        <a href={localizedHref('/articles/', Astro.currentLocale)}>← {t.backToBlog}</a>
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .post-measure {
    /* Measure with the body font size; keep the px-4 gutters outside the reading width. */
    font-size: var(--text-prose);
    max-inline-size: calc(var(--container-post) + 2rem);
  }

  .post-measure:lang(zh) {
    max-inline-size: calc(38rem + 2rem);
  }

  @supports (max-inline-size: 1ic) {
    .post-measure:lang(zh) {
      max-inline-size: calc(32ic + 2rem);
    }
  }
</style>
