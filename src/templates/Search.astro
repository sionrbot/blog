---
import PageLayout from '../layouts/PageLayout.astro';
import { localizedHref } from '../i18n/links';
import { useT } from '../i18n/t';
import { withBase } from '../utils/base-path';

const t = useT(Astro.currentLocale);
---

<PageLayout title={t.search} description={t.searchDescription}>
  <div
    class="not-prose font-sans"
    data-search
    data-bundle={withBase('/pagefind/pagefind.js')}
    data-base={withBase('/')}
    data-post-base={localizedHref('/articles/', Astro.currentLocale)}
    data-prompt={t.searchPrompt}
    data-loading={t.searchLoading}
    data-empty={t.searchEmpty}
    data-error={t.searchError}
    data-count={t.searchResultsCount}
  >
    <form role="search" class="space-y-3" action={localizedHref('/search/', Astro.currentLocale)}>
      <label for="search-query" class="block text-sm font-medium">
        {t.searchLabel}
      </label>
      <div class="flex gap-2">
        <input
          id="search-query"
          name="q"
          type="search"
          placeholder={t.searchPlaceholder}
          autocomplete="off"
          class="min-w-0 flex-1 rounded-xs border border-border bg-background px-3 py-2 text-base text-foreground"
        />
        <button
          type="submit"
          class="rounded-xs border border-border px-4 py-2 text-sm hover:bg-foreground/5"
        >
          {t.search}
        </button>
      </div>
    </form>
    <noscript>
      <p class="mt-4 text-sm text-muted">{t.searchRequiresJavaScript}</p>
    </noscript>
    <p
      data-search-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
      class="my-6 text-sm text-muted"
    >
      {t.searchPrompt}
    </p>
    <ol data-search-results class="m-0 list-none p-0"></ol>
    <button
      data-search-more
      type="button"
      hidden
      class="mt-6 rounded-xs border border-border px-4 py-2 text-sm hover:bg-foreground/5"
    >
      {t.searchMore}
    </button>
    <template data-search-result>
      <li class="border-t border-border py-6">
        <h2 class="m-0 font-serif text-2xl leading-snug font-normal break-words">
          <a data-result-link class="text-foreground underline-offset-4 hover:underline"></a>
        </h2>
        <time class="mt-2 block text-xs text-muted"></time>
        <p
          data-result-excerpt
          class="mt-3 text-sm leading-relaxed break-words [&_mark]:bg-primary/15 [&_mark]:text-foreground"
        ></p>
        <p data-result-tags class="mt-3 text-xs leading-relaxed break-words text-muted"></p>
      </li>
    </template>
  </div>
</PageLayout>

<script>
  import { setupSearch } from '../scripts/search';
  const root = document.querySelector<HTMLElement>('[data-search]');
  if (root) setupSearch(root);
</script>
