---
import type { Post } from '../../utils/posts';
import PostList from '../blog/PostList.astro';

interface Props {
  title: string;
  headingLevel?: 'h1' | 'h2';
  posts: Post[];
  moreLabel?: string;
  moreHref?: string;
}
const { title, headingLevel: Heading = 'h2', posts, moreLabel, moreHref } = Astro.props;
---

<section class="mx-auto hang max-w-5xl px-4 py-12">
  <div class="lg:pt-8">
    <Heading class="section-label">{title}</Heading>
    {moreHref && moreLabel && (
      <a href={moreHref} class="mt-1 inline-block font-sans text-sm">
        {moreLabel} →
      </a>
    )}
  </div>
  <PostList posts={posts} headingLevel={Heading === 'h1' ? 'h2' : 'h3'} />
</section>
