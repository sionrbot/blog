---
import Logo from '../../assets/logo.svg';
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  contentLang?: string;
  title: string;
  lede: string;
  actions?: { label: string; href: string; variant?: 'primary' | 'secondary' }[];
}
const { eyebrow, title, lede, contentLang, actions = [] } = Astro.props;
---

<section class="mx-auto max-w-5xl px-4 pt-14 pb-12 sm:pt-24 sm:pb-16">
  {eyebrow && (
    <p class="flex items-center gap-2 section-label">
      <Logo class="size-7 shrink-0 text-primary" aria-hidden="true" />
      {eyebrow}
    </p>
  )}
  <h1 lang={contentLang} class="mt-3 max-w-3xl text-5xl font-light tracking-tight sm:text-6xl">
    {title}
  </h1>
  <p lang={contentLang} class="mt-6 max-w-prose text-xl text-muted">
    {lede}
  </p>
  {actions.length > 0 && (
    <div class="mt-8 flex flex-wrap gap-3">
      {actions.map(({ label, href, variant }) => (
        <Button href={href} variant={variant}>
          {label}
        </Button>
      ))}
    </div>
  )}
</section>
