---
import type { Page } from 'astro';
import { localizedHref } from '../../i18n/links';
import { useT, formatMessage } from '../../i18n/t';

const t = useT(Astro.currentLocale);

interface Props {
  page: Pick<Page, 'currentPage' | 'lastPage' | 'url'>;
}
const { currentPage, lastPage, url } = Astro.props.page;
---

{lastPage > 1 && (
  <nav aria-label={t.pagination} class="mt-10 flex items-center justify-between font-sans text-sm">
    {url.prev ? (
      <a href={localizedHref(url.prev, Astro.currentLocale)} rel="prev">
        ← {t.newer}
      </a>
    ) : (
      <span />
    )}
    <span class="text-muted">{formatMessage(t.pageOf, { n: currentPage, total: lastPage })}</span>
    {url.next ? (
      <a href={localizedHref(url.next, Astro.currentLocale)} rel="next">
        {t.older} →
      </a>
    ) : (
      <span />
    )}
  </nav>
)}
