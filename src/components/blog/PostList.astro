---
import { localizedHref } from '../../i18n/links';
import { formatDate, postHref, type Post } from '../../utils/posts';
import TagList from './TagList.astro';

interface Props {
  posts: Post[];
  headingLevel?: 'h2' | 'h3';
}
const { posts, headingLevel: Heading = 'h2' } = Astro.props;
---

<ol class="divide-y divide-border border-y border-border">
  {posts.map((post) => (
    <li class="flex flex-col gap-2 py-8">
      <p class="font-sans text-sm text-muted">
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, Astro.currentLocale)}
        </time>
      </p>
      <div class="min-w-0 space-y-2">
        <Heading lang={post.data.lang} class="text-2xl font-medium wrap-anywhere">
          <a
            href={localizedHref(postHref(post), Astro.currentLocale)}
            class="text-foreground no-underline hover:text-primary"
          >
            {post.data.title}
          </a>
        </Heading>
        <p lang={post.data.lang} class="wrap-anywhere text-muted">
          {post.data.description}
        </p>
        <TagList contentLang={post.data.lang} tags={post.data.tags} />
      </div>
    </li>
  ))}
</ol>
