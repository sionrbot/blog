---
import { Icon } from 'astro-icon/components';
import { nav, site } from '../../config';
import { useT } from '../../i18n/t';

const t = useT(Astro.currentLocale);

const year = new Date().getFullYear();
const themeCredit = 'https://ondelva.com/themes/pilcrow';
---

<footer class="mt-24 border-t border-border">
  <div class="mx-auto hang max-w-5xl px-4 pt-10 pb-14 font-sans text-sm text-muted">
    <div>
      <p>
        © {year} {site.author} ·{' '}
        <a href={themeCredit} rel="nofollow" class="text-muted underline hover:text-foreground">
          Pilcrow
        </a>{' '}
        theme by ondelva
      </p>
      <ul class="mt-3 -ml-2.5 flex gap-1">
        {nav.social.map(({ label, href, icon }) => (
          <li>
            <a
              href={href}
              aria-label={label}
              rel="me noopener"
              class="inline-flex size-10 items-center justify-center text-muted hover:text-foreground"
            >
              <Icon name={icon} class="size-5" aria-hidden="true" />
            </a>
          </li>
        ))}
        <li>
          <a
            href="/rss.xml"
            aria-label={t.rss}
            class="inline-flex size-10 items-center justify-center text-muted hover:text-foreground"
          >
            <Icon name="lucide:rss" class="size-5" aria-hidden="true" />
          </a>
        </li>
      </ul>
    </div>
    <nav aria-label={t.footerNav} class="flex flex-wrap gap-x-16 gap-y-8">
      {nav.footer.map((group) => (
        <div>
          <p class="section-label">{group.title}</p>
          <ul class="mt-2 space-y-1.5" aria-label={group.title}>
            {group.links.map(({ label, href }) => (
              <li>
                <a href={href} class="text-muted no-underline hover:text-foreground">
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</footer>
