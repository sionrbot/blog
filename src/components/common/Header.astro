---
import Logo from '../../assets/logo.svg';
import { features, nav, site } from '../../config';
import { useT } from '../../i18n/t';
import { localizedHref, navigationHref } from '../../i18n/links';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

const t = useT(Astro.currentLocale);
const navigation = nav(t);

const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => {
  if (!href.startsWith('/') || href.startsWith('//')) return false;
  const h = href.split(/[?#]/, 1)[0].replace(/\/$/, '');
  const home = localizedHref('/', Astro.currentLocale).replace(/\/$/, '');
  return path === h || (h !== home && path.startsWith(`${h}/`));
};
---

<header class="mx-auto flex w-full max-w-5xl flex-wrap items-center gap-x-4 gap-y-4 px-4 py-6 md:gap-x-6">
  <a
    href={localizedHref('/', Astro.currentLocale)}
    class="flex min-w-0 grow basis-48 items-center gap-1.5 text-xl font-medium text-foreground no-underline"
  >
    <Logo class="size-7 shrink-0 text-primary" aria-hidden="true" />
    <span class="min-w-0 wrap-anywhere">{site.name}</span>
  </a>
  <div class="ms-auto flex shrink-0 items-center gap-2">
    {features.darkMode && <ThemeToggle />}
    <LanguageSwitcher />
  </div>
  <nav aria-label={t.mainNav} class="w-full min-w-0 md:w-auto">
    <ul class="flex flex-wrap gap-x-4 gap-y-2 font-sans text-sm md:gap-x-6">
      {navigation.header.map((item) => (
        <li>
          {'action' in item ? (
            <button
              type="button"
              data-search-open
              aria-haspopup="dialog"
              aria-controls="search-dialog"
              disabled
              class="cursor-pointer text-muted transition-colors hover:text-foreground disabled:cursor-default disabled:opacity-50"
            >
              {item.label}
            </button>
          ) : (
            <a
              href={navigationHref(item.href, Astro.currentLocale)}
              aria-current={
                isCurrent(navigationHref(item.href, Astro.currentLocale)) ? 'page' : undefined
              }
              class="text-muted no-underline transition-colors hover:text-foreground aria-[current=page]:text-foreground"
            >
              {item.label}
            </a>
          )}
        </li>
      ))}
    </ul>
  </nav>
  <noscript>
    <p class="w-full font-sans text-sm text-muted">{t.searchRequiresJavaScript}</p>
  </noscript>
</header>
