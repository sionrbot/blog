---
import Logo from '../../assets/logo.svg';
import { features, nav, site } from '../../config';
import { useT } from '../../i18n/t';
import { localizedHref, navigationHref } from '../../i18n/links';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

const t = useT(Astro.currentLocale);
const navigation = nav(t);

const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => {
  if (!href.startsWith('/') || href.startsWith('//')) return false;
  const h = href.split(/[?#]/, 1)[0].replace(/\/$/, '');
  const home = localizedHref('/', Astro.currentLocale).replace(/\/$/, '');
  const articles = localizedHref('/articles/', Astro.currentLocale).replace(/\/$/, '');
  const posts = localizedHref('/blog/', Astro.currentLocale);
  return (
    path === h ||
    (h !== home && path.startsWith(`${h}/`)) ||
    (h === articles && path.startsWith(posts))
  );
};
---

<header class="mx-auto flex w-full max-w-5xl flex-col flex-wrap items-start justify-between gap-x-6 gap-y-2 px-4 py-6 sm:flex-row sm:items-center">
  <a
    href={localizedHref('/', Astro.currentLocale)}
    class="flex items-center gap-1.5 text-xl font-medium text-foreground no-underline"
  >
    <Logo class="size-7 text-primary" aria-hidden="true" />
    {site.name}
  </a>
  <div class="flex flex-wrap items-center gap-2 sm:gap-4">
    <nav aria-label={t.mainNav}>
      <ul class="flex gap-4 font-sans text-sm sm:gap-6">
        {navigation.header.map(({ label, href }) => (
          <li>
            <a
              href={navigationHref(href, Astro.currentLocale)}
              aria-current={
                isCurrent(navigationHref(href, Astro.currentLocale)) ? 'page' : undefined
              }
              class="text-muted no-underline transition-colors hover:text-foreground aria-[current=page]:text-foreground"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    {features.darkMode && <ThemeToggle />}
    <LanguageSwitcher />
  </div>
</header>
