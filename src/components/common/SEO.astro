---
// Everything in <head>. Pages pass only title and description (plus image, type, jsonLd when needed) to BaseLayout.
import type { ImageMetadata } from 'astro';
import { canonicalPath, localizedHref } from '../../i18n/links';
import { resolveLocale } from '../../i18n/locales';
import { seo, site } from '../../config';
import { withBase, withoutBase } from '../../utils/base-path';

interface Props {
  title?: string; // site name only when omitted
  description?: string;
  image?: Pick<ImageMetadata, 'src' | 'width' | 'height'>;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[]; // per-page extras such as BlogPosting, BreadcrumbList
  noindex?: boolean;
}
const {
  title,
  description = site.description,
  image = site.defaultOgImage,
  type = 'website',
  jsonLd = [],
  noindex = false,
} = Astro.props;

const fullTitle = title ? seo.titleTemplate.replace('%s', title) : site.name;
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);
const ogImage = new URL(image.src, Astro.site);
const home = new URL(withBase('/'), Astro.site).href;
const locale = resolveLocale(Astro.currentLocale);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    description: site.description,
    url: home,
    inLanguage: locale,
    publisher: { '@type': seo.jsonLd.type, name: seo.jsonLd.name, url: home },
  },
  ...jsonLd.map((d) => ({ '@context': 'https://schema.org', ...d })),
];
// prevent </script> injection
const schemaJson = JSON.stringify(schema).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<link rel="alternate" type="application/rss+xml" title={site.name} href={withBase('/rss.xml')} />
{!noindex &&
  ['en', 'zh-Hans'].map((language) => (
    <link
      rel="alternate"
      hreflang={language}
      href={new URL(localizedHref(withoutBase(Astro.url.pathname), language), Astro.site)}
    />
  ))}
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />

<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content={String(image.width)} />
<meta property="og:image:height" content={String(image.height)} />

<meta name="twitter:card" content="summary_large_image" />
{seo.twitterHandle && <meta name="twitter:site" content={seo.twitterHandle} />}
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script is:inline type="application/ld+json" set:html={schemaJson}></script>
